class Solution {
    public int reverse(int x) {
        int num=0;
        int temp=x;
        while(temp!=0)
        {
            int dig=temp%10;
            if(num>Integer.MAX_VALUE/10 || (num==Integer.MAX_VALUE/10 && dig>7)){
                return 0;
            }
             if(num<Integer.MIN_VALUE/10 || (num==Integer.MIN_VALUE/10 && dig<-8)){
                return 0;
            }


            num=num*10+dig;
            temp=temp/10;

        }
        
        return num;
    }
}
